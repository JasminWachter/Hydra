interaction_rule(
  (execCode(Host, user) :-
    compromise(Host, _)),
  rule_desc('Web compromise achieves standard execCode - T1059 command and scripting interpreter', 0.9)).

% Bridge: feed web execution / privesc into the MITRE predicate names so the curated
