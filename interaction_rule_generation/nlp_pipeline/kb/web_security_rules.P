  rule_desc('Path traversal reads credential files (/etc/shadow, .env, config) - T1003', 0.65)).

% 7.3b XSS session hijack → credential material (T1185/T1550)
interaction_rule(
  (cred_obtained(Host, session_token, Host) :-
