interaction_rule(
  (exec_achieved(Host, web_user) :-
    (initial_access(Host, sqli, _Priv) ; initial_access(Host, sqli_heuristic, _Priv)),
    uses_database(Host, _Port, DbType),
    (DbType = 'postgresql' ; DbType = 'mysql' ; DbType = 'mssql')),
  rule_desc('SQLi to OS command via database functions (xp_cmdshell, COPY TO, sys_exec) - T1059', 0.6)).

% 5.3 File Upload → Execution via Webshell (T1059)
interaction_rule(
  (exec_achieved(Host, web_user) :-
    (initial_access(Host, upload_rce, _Priv) ; initial_access(Host, upload_rce_heuristic, _Priv))),
