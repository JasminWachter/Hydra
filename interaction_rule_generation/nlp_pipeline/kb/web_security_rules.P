% 4.8 Known CVE → Initial Access (T1190)
interaction_rule(
  (initial_access(Host, known_cve, user) :-
    recon_complete(Host, vuln_scan),
    remote_service_vulnerable(Host, Port, _CVE, _Svc),
    connects(_Net, Host, Port)),
  rule_desc('Known CVE on exposed service enables initial access - T1190', 0.85)).

% 4.9 SSRF → Initial Access to Internal Services (T1190)
interaction_rule(
  (initial_access(Host, ssrf, web_user) :-
    detected_vuln(Host, Port, ssrf),
