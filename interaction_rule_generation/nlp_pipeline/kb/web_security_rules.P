% 5.4 SSTI → Execution via Template Engine (T1059)
interaction_rule(
  (exec_achieved(Host, web_user) :-
    (initial_access(Host, ssti, _Priv) ; initial_access(Host, ssti_heuristic, _Priv))),
  rule_desc('Template injection escalates to OS command execution - T1059', 0.75)).

% 5.5 Deserialization → Execution (T1059)
interaction_rule(
  (exec_achieved(Host, web_user) :-
    (initial_access(Host, deserialization, _Priv) ; initial_access(Host, deserialization_heuristic, _Priv))),
  rule_desc('Deserialization gadget chain achieves code execution - T1059', 0.7)).

% 5.6 Known CVE → Execution (T1203)
interaction_rule(
  (exec_achieved(Host, user) :-
    initial_access(Host, known_cve, _Priv),
    exploit_possible(_CVE)),
  rule_desc('Known CVE exploit achieves code execution - T1203 Exploitation for Client Exec', 0.8)).

% 5.7 Any initial access + service → potential execution
interaction_rule(
  (exec_achieved(Host, web_user) :-
    initial_access(Host, _Method, _Priv),
    web_service(Host, _Port, _Tech)),
  rule_desc('Initial access on web service enables further exploitation toward execution', 0.5)).


/******************************************************/
/****  STAGE 6: PRIVILEGE ESCALATION              *****/
/****  Exec as low-priv → higher privilege        *****/
/****  Maps to MITRE T1068 Exploitation for PE    *****/
/******************************************************/

% 6.1 Local CVE enables privilege escalation (T1068)
interaction_rule(
  (priv_escalated(Host, web_user, root) :-
    exec_achieved(Host, web_user),
    vuln(Host, _CVE, _Pkg),
    exploit_possible(_CVE)),
  rule_desc('Local CVE exploit escalates web_user to root - T1068', 0.7)).

% 6.2 SUID/misconfiguration based privesc (T1548)
interaction_rule(
  (priv_escalated(Host, web_user, root) :-
    exec_achieved(Host, web_user),
    os(Host, 'linux')),
  rule_desc('Linux privesc: check SUID binaries, sudo misconfig, kernel exploits - T1548', 0.5)).

% 6.3 Database to OS escalation  
interaction_rule(
  (priv_escalated(Host, web_user, db_admin) :-
    exec_achieved(Host, web_user),
    uses_database(Host, _Port, _DbType)),
  rule_desc('Escalate from web user to database admin via SQL execution - T1068', 0.6)).


