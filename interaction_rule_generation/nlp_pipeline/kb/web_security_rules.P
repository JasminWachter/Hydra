% 4.9c IDOR → Initial Access (evidence-backed)
interaction_rule(
  (initial_access(Host, idor_access, web_user) :-
    detected_vuln(Host, Port, idor),
    has_cookie_auth(Host, Port),
    connects(_Net, Host, Port)),
  rule_desc('Evidence-backed IDOR path from static findings (session-bound object access)', 0.76)).

% 4.9d XXE → Initial Access (evidence-backed)
interaction_rule(
  (initial_access(Host, xxe_file_read, web_user) :-
    detected_vuln(Host, Port, xxe),
    connects(_Net, Host, Port)),
  rule_desc('Evidence-backed XXE path from static findings (file/entity expansion access)', 0.72)).

% 4.9e Path Traversal → Initial Access (evidence-backed)
interaction_rule(
  (initial_access(Host, path_traversal_read, web_user) :-
    detected_vuln(Host, Port, path_traversal),
    connects(_Net, Host, Port)),
  rule_desc('Evidence-backed path traversal access route from static findings', 0.82)).

% 4.10 Default/No Auth → Initial Access (T1078)
interaction_rule(
  (initial_access(Host, default_creds, user) :-
    no_auth_required(Host, Port),
    connects(_Net, Host, Port)),
  rule_desc('No authentication required - T1078 Valid Accounts (default)', 0.95)).

% 4.11 XSS → Session Access (T1185 Browser Session Hijacking)
interaction_rule(
  (initial_access(Host, xss_session, web_user) :-
    detected_vuln(Host, Port, xss),
    has_cookie_auth(Host, Port),
    connects(_Net, Host, Port)),
  rule_desc('Evidence-backed XSS session hijacking from static findings - T1185', 0.82)).

% 4.11b XSS → Reflected Access (evidence-backed without cookie requirement)
interaction_rule(
  (initial_access(Host, xss_reflected_evidence, web_user) :-
    detected_vuln(Host, Port, xss),
    has_user_input(Host, Port, _InputType),
    connects(_Net, Host, Port)),
  rule_desc('Evidence-backed reflected XSS path from static findings', 0.76)).

% 4.12 XSS reflective route (heuristic fallback without scanner evidence)
interaction_rule(
  (initial_access(Host, xss_reflection, web_user) :-
    xss_confirmed(Host, Port),
    has_cookie_auth(Host, Port),
    connects(_Net, Host, Port)),
  rule_desc('XSS reflection route enables authenticated web access - heuristic fallback', 0.62)).


/******************************************************/
