    access_sensitive_data_in_device_logs(Host) :-
        app_installed(Host, App, Version),
        mobile_perm(App, 'READ_LOGS'),
        os(Host, 'Android'),
        Version @< '4.1'.

    access_sensitive_data_in_device_logs(Host) :-
        app_installed(Host, App, Version),
        os(Host, 'Android'),
        Version @>= '4.1',
        local_pe_vulnerable(Host, CVE),
        priv_escalation(Host, user, root).

    compromise(Host, user) :-
        access_sensitive_data_in_device_logs(Host).
