    signed_malware(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        os(Host, OS),
        member(OS, [macOS, windows]),
        compromised_certificate(Cert),
        uses_signed_code(Host, Cert).

compromise(Host, user) :-
