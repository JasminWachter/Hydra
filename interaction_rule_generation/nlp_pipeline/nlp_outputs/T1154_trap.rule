    trap_execution(Host, User) :-
        attacker_at(net),
        connects(net, Host, _Port),
        user_on_host(User, Host),
        os(Host, linux),
        exec(Host, User).

    persistence(Host, 'trap_command') :-
        trap_execution(Host, User).
% ---- RULE LLM END ----
