    access_contact_list(Host) :-
        attacker_at(net),
        connects(net, Host, _Port),
        app_installed(Host, app, version),
        mobile_perm(app, 'access_contacts'),
        exec(Host, user).

    compromise(Host, user) :-
        access_contact_list(Host).
