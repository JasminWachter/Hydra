    malicious_app_installed(Host, App) :-
        attacker_at(net),
        connects(net, Host, _Port),
        app_installed(Host, App, _Version),
        mobile_perm(App, accessibility_features).

    compromise(Host, user) :-
        malicious_app_installed(Host, App),
        mobile_perm(App, accessibility_features).

    defense_disabled(Host, uninstallation_prevention) :-
