% ---- RULE LLM START (minimal) ----
    multiband_communication(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port1),
        connects(Network, Host, Port2),
        Port1 \= Port2,
        c2_channel(Host, Protocol1),
        c2_channel(Host, Protocol2),
        Protocol1 \= Protocol2.

    compromise(Host, user) :-
        multiband_communication(Host).
