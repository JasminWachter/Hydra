    masquerading_detected(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        (manipulated_metadata(Host);
         renamed_utility(Host);
         misleading_name(Host)).

    compromise(Host, user) :-
        masquerading_detected(Host).
% ---- RULE LLM END ----
