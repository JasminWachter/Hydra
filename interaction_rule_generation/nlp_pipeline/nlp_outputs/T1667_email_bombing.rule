    email_bombing(Host) :-
        attacker_at(net),
        connects(net, Host, _Port),
        service(Host, _Port, _, email, _),
        overload_inbox(Host).

    overload_inbox(Host) :-
        service(Host, _Port, _, email, _),
        sends_mass_emails(Host).

    sends_mass_emails(Host) :-
        attacker_at(net),
        connects(net, Host, _Port),
        service(Host, _Port, _, email, _).
