    application_window_discovery(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        os(Host, OS),
        member(OS, [macOS, Windows, Linux]),
        exec(Host, User),
        compromise(Host, user).

    compromise(Host, user) :-
