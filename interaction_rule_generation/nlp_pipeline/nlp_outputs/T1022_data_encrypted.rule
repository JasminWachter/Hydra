% ---- RULE LLM START (minimal) ----
    encrypted_exfiltration(Host, DataKind, Channel) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        has_data(Host, DataKind),
        exfiltrated(Host, DataKind, Channel),
        Channel \= 'unencrypted'.

    compromise(Host, user) :-
