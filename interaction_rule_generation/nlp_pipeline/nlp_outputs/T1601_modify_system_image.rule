    modify_system_image(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        os(Host, embedded),
        defense_disabled(Host, os_integrity),
        compromised_device(Host).

    compromised_device(Host) :-
        modify_system_image(Host).
% ---- RULE LLM END ----
