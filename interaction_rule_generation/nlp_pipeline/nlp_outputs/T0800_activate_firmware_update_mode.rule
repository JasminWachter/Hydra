    firmware_update_mode_activated(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        ics_exposed_endpoint(Host, Port),
        role(Host, protection_relay).

    deny_functionality(Host) :-
        firmware_update_mode_activated(Host),
        defense_disabled(Host, process_monitoring).
% ---- RULE LLM END ----
