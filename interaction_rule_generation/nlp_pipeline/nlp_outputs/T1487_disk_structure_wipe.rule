    disk_structure_wipe(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        exec(Host, User),
        compromise(Host, admin),
        os(Host, OS),
        member(OS, [windows, macos, linux]),
        critical_data_overwritten(Host).

    critical_data_overwritten(Host) :-
        overwrite_mbr(Host);
        overwrite_partition_table(Host).

    overwrite_mbr(Host) :-
        exec(Host, User),
        compromise(Host, admin),
        mbr_accessible(Host).

    overwrite_partition_table(Host) :-
        exec(Host, User),
        compromise(Host, admin),
        partition_table_accessible(Host).

    mbr_accessible(Host) :-
        exposed(Host, Port),
        service(Host, Port, _, mbr_service, _).

    partition_table_accessible(Host) :-
        exposed(Host, Port),
        service(Host, Port, _, partition_service, _).
