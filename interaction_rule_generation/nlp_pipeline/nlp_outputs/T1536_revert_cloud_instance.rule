        attacker_at(Network),
        connects(Network, Host, Port),
        cloud_account(Account, Provider),
        cloud_cred(User, 'admin'),
        compromise(Host, user),
        event(Host, 'defense-evasion', 'T1536', EvidenceId).

    % Rule to indicate that an attacker can revert a cloud instance to evade detection
    can_revert_instance(Host) :-
