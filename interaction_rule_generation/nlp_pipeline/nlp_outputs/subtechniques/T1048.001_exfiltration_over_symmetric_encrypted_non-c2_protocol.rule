    exfiltrated(Host, data, symmetric_encrypted_non_c2_protocol) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        encrypted_traffic(Host, symmetric),
        not(c2_channel(Host, _)).
% ---- RULE LLM END ----
