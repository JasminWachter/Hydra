    internet_connection_discovery(Host) :-
        compromised_device(Host),
        command_executed(Host, 'adb shell netstat', User),
        reachable(Host, C2Server, Port),
        c2_channel(C2Server, Port).

    compromised_device(Host) :-
        attacker_at(net),
        connects(net, Host, _Port).
