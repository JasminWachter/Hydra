% ---- RULE LLM START (minimal) ----
    web_portal_capture(Host) :-
        attacker_at(net),
        connects(net, Host, _Port),
        exposed(Host, _Port),
        service(Host, _Port, _, 'web', _),
        exec(Host, 'admin'),
        loot(Host, 'credentials', _Id).

    compromise(Host, user) :-
        web_portal_capture(Host).
