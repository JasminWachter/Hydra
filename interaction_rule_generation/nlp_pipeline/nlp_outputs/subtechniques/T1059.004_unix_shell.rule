    exec(Host, User) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        user_on_host(User, Host),
        os(Host, unix),
        c2_channel(Host, Protocol).

    compromise_from_exec(Host, user) :-
        exec(Host, User).
