% ---- RULE LLM START (minimal) ----
    hijack_cloud_service(Host) :-
        attacker_at(net),
        connects(net, Host, _Port),
        cloud_account(Host, Provider),
        uses_legitimate_service(Host, Service),
        sends_mass_emails(Host).

    compromise(Host, user) :-
        hijack_cloud_service(Host).
