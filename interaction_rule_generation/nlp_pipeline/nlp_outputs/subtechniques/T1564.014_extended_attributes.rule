    uses_extended_attributes(Host) :-
        attacker_at(net),
        connects(net, Host, _Port),
        os(Host, linux),
        file_contains_embedded_payload(File, Host),
        benign_file(File).

    uses_extended_attributes(Host) :-
        attacker_at(net),
        connects(net, Host, _Port),
        os(Host, macos),
        file_contains_embedded_payload(File, Host),
        benign_file(File).

    compromise(Host, user) :-
        uses_extended_attributes(Host).
% ---- RULE LLM END ----
