% ---- RULE LLM START (minimal) ----
    modify_system_image(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        exposed(Host, Port),
        auth_possible(Host, User, password),
        auth_usable_cred(User, Host, password).

    compromise(Host, user) :-
        modify_system_image(Host).
