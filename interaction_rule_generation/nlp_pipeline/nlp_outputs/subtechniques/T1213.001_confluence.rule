% ---- RULE LLM START (minimal) ----
    confluence_data_exfiltration(Host, DataKind) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        app_installed(Host, 'Confluence', _Version),
        has_data(Host, DataKind),
        member(DataKind, ['policies', 'network_diagrams', 'system_architecture', 'technical_documentation', 'credentials', 'project_schedules', 'source_code', 'network_links']).

    compromise(Host, user) :-
        confluence_data_exfiltration(Host, _DataKind).
