    user_evasion_detected(Host) :-
        device(Host),
        sensor(Host, motion),
        malicious_app_installed(Host, App),
        app_installed(Host, App, _Version),
        not(user_activity_check(Host)).

    compromise(Host, user) :-
        user_evasion_detected(Host).
% ---- RULE LLM END ----
