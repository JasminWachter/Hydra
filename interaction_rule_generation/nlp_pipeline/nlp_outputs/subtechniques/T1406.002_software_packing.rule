        attacker_at(Network),
        connects(Network, Host, Port),
        app_installed(Host, App, Version),
        compress_data(App, _),
        encrypt_data(App, _).

    compromise(Host, user) :-
        software_packing_detected(Host).
% ---- RULE LLM END ----
