    sms_pumping_attack(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        service(Host, Port, proto, messaging_service, version),
        exposed(Host, Port).

    compromise(Host, user) :-
        sms_pumping_attack(Host).
% ---- RULE LLM END ----
