        attacker_at(Network),
        connects(Network, Host, Port),
        valid_account(User, Host),
        cloud_cred(User, CredentialType),
        cloud_account(CloudAccount, Provider),
        persistence(Host, method_cloud_account_creation).

    compromise(Host, user) :-
        cloud_account(CloudAccount, Provider),
        persistence(Host, method_cloud_account_creation).
