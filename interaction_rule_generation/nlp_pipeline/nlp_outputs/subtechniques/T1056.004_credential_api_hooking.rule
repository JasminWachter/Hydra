        attacker_at(Network),
        connects(Network, Host, Port),
        os(Host, windows),
        (hook_procedure_installed(Host);
         iat_hook_installed(Host);
         inline_hook_installed(Host)).

    credential_api_hooking(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        os(Host, linux),
        ld_preload_hook_installed(Host).

    credential_api_hooking(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        os(Host, macos),
        dyld_insert_libraries_hook_installed(Host).

    compromise(Host, user) :-
        credential_api_hooking(Host).
