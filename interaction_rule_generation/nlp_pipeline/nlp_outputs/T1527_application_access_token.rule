    compromised_access_token(User, Token) :-
        attacker_at(net),
        stolen_token(User, Token).

compromise(Host, user) :-
    compromised_access_token(User, Token),
    user_on_host(User, Host),
    auth_usable_cred(User, Host, oauth_token).
% ---- RULE LLM END ----
