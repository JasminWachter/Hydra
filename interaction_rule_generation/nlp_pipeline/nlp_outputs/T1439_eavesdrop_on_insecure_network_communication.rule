% description: If network traffic between the mobile device and remote servers is unencrypted or is encrypted in an insecure manner, then an adversary positioned on the network can eavesdrop on communication.(Citation: mHealth)
% generated_by: notebook_generate_rules

% ---- RULE LLM START (minimal) ----
    eavesdrop_possible(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        exposed(Host, Port),
        service(Host, Port, Proto, Service, Version),
        (Proto = 'http'; Proto = 'ftp'; Proto = 'telnet'). % Example of insecure protocols

    compromise(Host, user) :-
        eavesdrop_possible(Host).
