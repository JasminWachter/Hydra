    remote_system_discovery(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        exposed(Host, Port),
        service(Host, Port, _, Service, _),
        member(Service, [ping, net_view, esxcli, arp, cdp]).
    compromise(Host, user) :-
        remote_system_discovery(Host).
