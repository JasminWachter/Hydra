        attacker_at(Network),
        connects(Network, Host, Port),
        app_installed(Host, App, Version),
        vulnerable_app(App, Version).

    compromise(Host, elevated_privileges) :-
        code_injection_possible(Host),
        exec(Host, elevated_privileges).
