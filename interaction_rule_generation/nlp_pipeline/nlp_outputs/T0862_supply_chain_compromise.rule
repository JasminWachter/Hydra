    supply_chain_compromise(Host) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        app_installed(Host, App, Version),
        trojanized(App, Version).

    compromise(Host, user) :-
        supply_chain_compromise(Host).
% ---- RULE LLM END ----
