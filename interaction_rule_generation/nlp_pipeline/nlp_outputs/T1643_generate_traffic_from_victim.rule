    generate_traffic_from_victim(Host) :-
        compromised_device(Host),
        app_installed(Host, App, _Version),
        mobile_perm(App, 'SEND_SMS'),
        os(Host, 'Android').

    generate_traffic_from_victim(Host) :-
        compromised_device(Host),
        app_installed(Host, App, _Version),
        os(Host, 'iOS'),
        \+ mobile_perm(App, 'SEND_SMS').
