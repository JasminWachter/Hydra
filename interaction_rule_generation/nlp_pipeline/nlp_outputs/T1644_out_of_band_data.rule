    c2_channel(Host, Channel) :-
        compromised_device(Host),
        out_of_band_channel(Channel),
        mobile_perm(App, notification_access),
        app_installed(Host, App, _Version).

    compromised_device(Host) :-
        attacker_at(net),
        connects(net, Host, _Port).

    out_of_band_channel(sms).
    out_of_band_channel(nfc).
    out_of_band_channel(bluetooth).
