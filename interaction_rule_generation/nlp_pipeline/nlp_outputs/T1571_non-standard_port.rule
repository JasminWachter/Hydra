    non_standard_port_usage(Host, Proto, Port) :-
        attacker_at(Network),
        connects(Network, Host, Port),
        service(Host, Port, Proto, _, _),
        \+ standard_port(Proto, Port).

    compromise(Host, user) :-
        non_standard_port_usage(Host, _, _).

    standard_port(https, 443).
    standard_port(http, 80).
    standard_port(ftp, 21).
    standard_port(smtp, 25).
    standard_port(pop3, 110).
    standard_port(imap, 143).
