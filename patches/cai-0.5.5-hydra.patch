@@ -0,0 +1,242 @@
+"""Hybrid Reasoning Base Agent - Red team agent using MulVAL attack graphs"""
+import os
+import json
+from pathlib import Path
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dotenv import load_dotenv
+from openai import AsyncOpenAI
+
+from cai.sdk.agents import Agent, OpenAIChatCompletionsModel, function_tool
+from cai.tools.reconnaissance.generic_linux_command import generic_linux_command
+from cai.tools.web.search_web import make_web_search_with_explanation
+from cai.tools.reconnaissance.exec_code import execute_code
+from cai.util import load_prompt_template, create_system_prompt_renderer
+from cai.agents.guardrails import get_security_guardrails
+
+# Load environment and configuration
+load_dotenv()
+
+_ATTACK_PATHS_CONTEXT: ContextVar[dict] = ContextVar(
+    "hybrid_attack_paths_context",
+    default={},
+)
+
+
+@contextmanager
+def attack_paths_context(attack_paths: dict | None):
+    """Set per-run attack paths context for tool access."""
+    token = _ATTACK_PATHS_CONTEXT.set(attack_paths if attack_paths else {})
+    try:
+        yield
+    finally:
+        _ATTACK_PATHS_CONTEXT.reset(token)
+
+
+@function_tool
+async def get_attack_path(path_id: int) -> str:
+    """
+    Retrieve the full step-by-step details for a specific MulVAL attack path.
+
+    Call this tool when you are ready to execute a path. Use the path_id shown
+    in the attack paths index you received at the start of the session.
+
+    Before executing this path, assess whether the preconditions are plausible
+    against the live target. If a precondition appears to be a false positive
+    (e.g. the stated service/version does not match what you observe on the live
+    target), discard this path immediately and call get_attack_path with the next
+    path_id instead.
+
+    Args:
+        path_id: Integer ID of the path to retrieve (as shown in the index).
+
+    Returns:
+        Plain-text description of the path's preconditions, techniques, and goal,
+        or an error message if the path_id is not found.
+    """
+    loaded_paths = _ATTACK_PATHS_CONTEXT.get()
+    if not loaded_paths:
+        return "No attack paths loaded. Paths were not registered for this session."
+
+    paths = loaded_paths.get("paths", [])
+    path = next((p for p in paths if p["path_id"] == path_id), None)
+
+    if path is None:
+        available = [p["path_id"] for p in paths]
+        return f"Path {path_id} not found. Available path IDs: {available}"
+
+    lines = [
+        f"path_id={path['path_id']} length={path['length']} "
+        f"techniques={path['technique_count']} min_confidence={path['min_confidence']}",
+        f"goal: {path['goal']}",
+        "steps:",
+    ]
+    for step in path["steps"]:
+        step_type = step.get("type")
+        if step_type == "precondition":
+            lines.append(f"  [precondition] {step['description']}")
+        elif step_type == "technique":
+            conf = step.get("confidence", "N/A")
+            rule = step.get("rule_description") or step.get("technique_id", "unknown")
+            derived = step.get("derived_fact", "")
+            lines.append(f"  [technique] {rule} (confidence: {conf}) -> {derived}")
+        elif step_type == "goal":
+            lines.append(f"  [goal] {step['description']}")
+
+    return "\n".join(lines)
+def rewrite_paths_target(attack_paths: dict, real_host: str, real_port: int) -> dict:
+    """Replace static scan-time host/port in MulVAL step descriptions with actual target.
+
+    Precomputed graphs are generated with a placeholder port (usually 80). At runtime
+    the Docker container is assigned a random host port, so without this rewrite the
+    agent sees contradictory preconditions and discards every path as a false positive.
+    """
+    import copy
+    import re
+    from collections import Counter
+
+    if not attack_paths:
+        return attack_paths
+
+    result = copy.deepcopy(attack_paths)
+    old_host = result.get("target_host", "localhost")
+
+    ports: list[str] = []
+    for path in result.get("paths", []):
+        for step in path.get("steps", []):
+            ports += re.findall(rf'{re.escape(old_host)},(\d+)', step.get("description", ""))
+
+    if not ports:
+        return result
+
+    old_port = Counter(ports).most_common(1)[0][0]
+    if old_port == str(real_port):
+        return result
+
+    result["target_host"] = f"{real_host}:{real_port}"
+    for path in result.get("paths", []):
+        for step in path.get("steps", []):
+            if "description" in step:
+                step["description"] = step["description"].replace(
+                    f"{old_host},{old_port}", f"{real_host},{real_port}"
+                )
+
+    return result
+
+
+MODEL_NAME = os.getenv("CAI_MODEL", "gemini/gemini-2.0-flash-exp")
+
+# Load agent instructions
+SYSTEM_PROMPT = load_prompt_template("prompts/system_hybrid_reasoner_agent.md")
+
+# Configure tools
+TOOLS = [
+    generic_linux_command,
+    execute_code,
+    get_attack_path,
+]
+
+if os.getenv('PERPLEXITY_API_KEY'):
+    TOOLS.append(make_web_search_with_explanation)
+
+# Configure security guardrails
+# For red team operations, respect CAI_GUARDRAILS environment variable
+# Default to disabled for security testing scenarios
+guardrails_enabled = os.getenv("CAI_GUARDRAILS", "false").lower() != "false"
+
+if guardrails_enabled:
+    INPUT_GUARDRAILS, OUTPUT_GUARDRAILS = get_security_guardrails()
+else:
+    INPUT_GUARDRAILS, OUTPUT_GUARDRAILS = [], []
+
+# Create the hybrid reasoner agent
+# For Gemini models, LiteLLM needs AsyncOpenAI client (it routes internally to Gemini API)
+# LiteLLM will use GEMINI_API_KEY or GOOGLE_API_KEY from environment
+hybrid_reasoner_agent = Agent(
+    name="Hybrid Reasoner Agent",
+    description=(
+        "Red team agent that performs security assessments using MulVAL attack graphs. "
+        "Analyzes attack paths and exploits vulnerabilities to achieve penetration goals."
+    ),
+    instructions=create_system_prompt_renderer(SYSTEM_PROMPT),
+    tools=TOOLS,
+    input_guardrails=INPUT_GUARDRAILS,
+    output_guardrails=OUTPUT_GUARDRAILS,
+    model=OpenAIChatCompletionsModel(
+        model=MODEL_NAME,
+        openai_client=AsyncOpenAI(
+            api_key=os.getenv('GEMINI_API_KEY') or os.getenv('GOOGLE_API_KEY') or "dummy-key",
+            base_url="http://0.0.0.0:11434"  # Will be ignored by LiteLLM for provider/ prefixed models
+        ),
+    )
+)
+
+
+def transfer_to_hybrid_reasoner_agent(**kwargs):  # pylint: disable=W0613
+    """Transfer control to the hybrid reasoner agent."""
+    return hybrid_reasoner_agent
+
+
+def load_attack_paths(paths_file: str = None) -> dict:
+    """
+    Load attack paths from MulVAL graphs/paths.json file.
+    
+    Args:
+        paths_file: Optional path to paths.json. If None, searches standard locations.
+    
+    Returns:
+        Attack paths dictionary or None if file not found.
+    """
+    if paths_file is None:
+        possible_paths = [
+            Path.cwd() / "MulVAL" / "graphs" / "paths.json",
+            Path(__file__).parent.parent.parent / "MulVAL" / "graphs" / "paths.json",
+            Path.cwd() / "graphs" / "paths.json",
+        ]
+        
+        for path in possible_paths:
+            if path.exists():
+                paths_file = str(path)
+                break
+    
+    if paths_file and Path(paths_file).exists():
+        with open(paths_file, 'r', encoding='utf-8') as f:
+            return json.load(f)
+    
+    return None
