+          - metavariable-regex:
+              metavariable: $F
+              regex: ^(unserialize|node_serialize\.unserialize|serialize\.unserialize)$
+
+  # --- Prototype pollution: user-controlled object merged into a target (structural) ---
+  - id: js-prototype-pollution-merge
+    languages: [javascript, typescript]
+    severity: ERROR
+    message: User-controlled object merged into a target may pollute __proto__ (prototype pollution).
+    metadata:
