+#!/usr/bin/env python3
+"""Curate full_interaction_rules.P down to the MITRE rules that can actually fire on web
+scanner facts AND that extend a web-established compromise (rather than fire standalone).
+
+Two fixpoints:
+  1. fireable: a rule's head becomes available when every positive, non-builtin, non-negated
+     body literal is available (seeded with scanner-produced + web-derived predicates).
+  2. web_grounded: a predicate transitively depends on a web-exploitation "anchor"
+     (detected_vuln / taint_flow / *_confirmed / initial_access / exec_achieved / compromise /
+     execCode / exec / vuln / remote_service_vulnerable / cred_obtained / ...).
+
+A rule is kept iff it is fireable AND web_grounded. Output: full_post_exploit_rules.P (rules
+only; declarations live in _preamble.P).
+"""
+import re
+import sys
+from pathlib import Path
+
+KB = Path(__file__).resolve().parent.parent          # knowledge-base directory
+SRC = KB / 'full_interaction_rules.P'
+OUT = KB / 'full_post_exploit_rules.P'
+
+# Predicates the scanner front-end actually emits (see parsers/ + base_parser + taint additions)
+SCANNER_PRODUCED = {
+    'attacker_at', 'host', 'connects', 'exposed', 'service', 'os', 'role', 'has_data',
+    'web_service', 'has_login_form', 'has_file_upload', 'has_user_input', 'has_api_endpoint',
+    'has_cookie_auth', 'uses_database', 'auth_service', 'web_framework',
+    'dangerous_http_methods', 'no_auth_required', 'auth_possible', 'vuln', 'exploit_possible',
+    'remote_service_vulnerable', 'detected_vuln', 'taint_flow', 'flag_location', 'access_gate',
+    'pkg',
+}
+# Predicates web_security_rules.P derives (so they are available to MITRE bodies)
+WEB_DERIVED = {
+    'recon_complete', 'initial_access', 'exec_achieved', 'priv_escalated', 'cred_obtained',
+    'lateral_access', 'data_exfiltrated', 'compromise', 'execCode', 'exec',
+    'info_disclosure_confirmed',
+} | {f'{c}_surface' for c in (
+    'sqli', 'cmdi', 'ssrf', 'xss', 'path_traversal', 'auth_bypass', 'idor', 'upload_vuln',
+    'deserialization', 'nosql_injection', 'xxe', 'ssti', 'cors_misconfiguration',
+)} | {f'{c}_confirmed' for c in (
+    'sqli', 'cmdi', 'ssrf', 'xss', 'path_traversal', 'auth_bypass', 'idor', 'upload_vuln',
+    'deserialization', 'nosql_injection', 'xxe', 'ssti',
+)}
+
+# Evidence that real web exploitation happened; MITRE rules must transitively depend on one.
+ANCHORS = {
+    'detected_vuln', 'taint_flow', 'initial_access', 'exec_achieved', 'priv_escalated',
+    'compromise', 'execCode', 'exec', 'vuln', 'remote_service_vulnerable', 'exploit_possible',
+    'cred_obtained', 'lateral_access', 'data_exfiltrated',
+} | {f'{c}_confirmed' for c in (
+    'sqli', 'cmdi', 'ssrf', 'xss', 'path_traversal', 'auth_bypass', 'idor', 'upload_vuln',
+    'deserialization', 'nosql_injection', 'xxe', 'ssti',
+)}
+
+BUILTINS = {'member', 'nonvar', 'var', 'is', 'append', 'length', 'nth', 'msort', 'sort',
+            'between', 'succ_or_zero', 'true', 'fail'}
+
+LITERAL_RE = re.compile(r'([a-z_][a-zA-Z0-9_]*)\s*\(')
+
+
+def split_clauses(text: str):
+    """Yield each top-level interaction_rule(...) clause text."""
+    i, n = 0, len(text)
+    while True:
+        start = text.find('interaction_rule(', i)
+        if start < 0:
+            return
+        depth, j = 0, start
+        while j < n:
+            c = text[j]
+            if c == '(':
+                depth += 1
+            elif c == ')':
+                depth -= 1
+                if depth == 0:
+                    break
+            j += 1
+        # include the clause terminator '.' that follows the closing paren
+        k = j + 1
+        while k < n and text[k] in ' \t\r\n':
+            k += 1
+        if k < n and text[k] == '.':
+            j = k
+        yield text[start:j + 1]
+        i = j + 1
+
+
+def parse_rule(clause: str):
+    """Return (head_functor, body_positive_functors, full_clause) or None."""
+    m = re.search(r'\(\s*\((.*)\)\s*,\s*rule_desc', clause, re.DOTALL)
+    if not m:
+        return None
+    body_block = m.group(1)
+    if ':-' in body_block:
+        head_txt, body_txt = body_block.split(':-', 1)
+    else:
+        head_txt, body_txt = body_block, ''
+    hm = LITERAL_RE.search(head_txt)
+    if not hm:
+        return None
+    head = hm.group(1)
+    # strip negated literals: drop the functor immediately following \+
+    body_txt = re.sub(r'\\\+\s*[a-z_][a-zA-Z0-9_]*\s*\([^()]*\)', ' ', body_txt)
+    body = {f for f in LITERAL_RE.findall(body_txt)
+            if f not in BUILTINS and f != 'rule_desc'}
+    return head, body, clause
+
+
+def main():
+    text = SRC.read_text(encoding='utf-8', errors='replace')
+    rules = [r for r in (parse_rule(c) for c in split_clauses(text)) if r]
+    print(f"parsed {len(rules)} rules")
+
+    # Fixpoint 1: fireable
+    available = set(SCANNER_PRODUCED) | set(WEB_DERIVED)
+    changed = True
+    while changed:
+        changed = False
+        for head, body, _ in rules:
+            if head in available:
+                continue
+            if body <= available:
+                available.add(head)
+                changed = True
+    fireable = [r for r in rules if r[1] <= available]
+    print(f"fireable: {len(fireable)}")
+
+    # Fixpoint 2: web_grounded (head depends transitively on an anchor)
+    grounded = set(ANCHORS)
+    changed = True
+    while changed:
+        changed = False
+        for head, body, _ in fireable:
+            if head in grounded:
+                continue
+            if body & grounded:
+                grounded.add(head)
+                changed = True
+    # require an actual web-grounded dependency in the body (extend, don't invent)
+    kept = [r for r in fireable if r[1] & grounded]
+    print(f"kept (fireable AND web-grounded): {len(kept)}")
+
+    # Keep the original declaration block (everything before the first interaction_rule) so
+    # every MITRE predicate the kept rules reference stays declared/tabled. Duplicates with
+    # web_security_rules.P are tolerated by MulVAL (warnings only).
+    decl_end = text.find('interaction_rule(')
+    decls = text[:decl_end].rstrip()
+
+    header = (
+        "/**** full_post_exploit_rules.P — CURATED subset of full_interaction_rules.P ****/\n"
+        "/**** Generated by kb/tools/curate_post_exploit.py. Do not edit by hand.     ****/\n"
+        "/**** Kept rules are fireable from web scanner facts AND extend a web-        ****/\n"
+        "/**** established compromise (transitive dependency on an exploitation anchor).****/\n\n"
+    )
+    OUT.write_text(header + decls + "\n\n" + "\n".join(r[2] for r in kept) + "\n",
+                   encoding='utf-8')
+    print(f"wrote {OUT} with {len(kept)} rules")
+    # report kept technique codes
+    codes = sorted({m.group(1) for r in kept
+                    for m in [re.search(r"rule_desc\('([^']+)'", r[2])] if m})
+    print("sample kept techniques:", "; ".join(codes[:20]))
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/MulVAL/kb/web_security_rules.P b/MulVAL/kb/web_security_rules.P
