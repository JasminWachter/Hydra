+def create_paths_index_message(attack_paths: dict) -> str:
+    """
+    Format a compact path index for the agent's opening context.
+
+    Only path IDs, lengths, technique counts, confidence, and goals are included.
+    Full step details are retrieved on-demand via get_attack_path(path_id).
+
+    Args:
+        attack_paths: Dictionary containing attack paths from MulVAL.
+
+    Returns:
+        Compact plain-text index with one line per path and a retrieval instruction.
+    """
+    if not attack_paths:
+        return "No attack paths available. Proceed with manual reconnaissance."
+
+    paths = attack_paths.get("paths", [])
+    total = attack_paths.get("total_paths", len(paths))
+    target = attack_paths.get("target_host", "unknown")
+
+    lines = [
+        f"MulVAL attack paths loaded: {total} paths targeting {target}.",
+        "Path index (sorted by length — start with the shortest path):",
+    ]
+    for path in sorted(paths, key=lambda p: p["length"]):
+        lines.append(
+            f"  path_id={path['path_id']}: length={path['length']}, "
+            f"techniques={path['technique_count']}, "
+            f"min_confidence={path['min_confidence']}, "
+            f"goal={path['goal']}"
+        )
+    lines.append("Call get_attack_path(path_id) to retrieve full steps for any path.")
+
+    return "\n".join(lines)
