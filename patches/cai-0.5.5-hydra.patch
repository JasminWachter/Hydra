+% Utility Predicates
+member(X,[X|_]).
+member(X,[_|T]) :- member(X,T).
+
+append([],L,L).
+append([H|T],L,[H|R]) :- append(T,L,R).
+
+reverse(L,R) :- reverse_acc(L,[],R).
+reverse_acc([],Acc,Acc).
+reverse_acc([H|T],Acc,R) :- reverse_acc(T,[H|Acc],R).
+
+file_extension(File,Ext) :- atom(File), atom_codes(File,Cs), reverse(Cs,RCs), append(ExtCodes,[46|_],RCs), !, reverse(ExtCodes,ExtRev), atom_codes(Ext,ExtRev).
+
+protocol(Host,Proto) :- protocol(Host,Proto,_).
+
+protocol_in_use(Proto) :- protocol(_,Proto,_).
+uses_common_port(Host,Port) :- commonly_used_port(Host,Port).
+encrypted_c2_channel(Host) :- encrypted_c2_traffic(Host).
+dga_c2_channel(Host) :- dga_used_for_c2(Host).
+
+% Interaction Rules
+% --- T0800_activate_firmware_update_mode ---
+    firmware_update_mode_activated(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port),
+        role(Host, protection_relay).
+
+    deny_functionality(Host) :-
+        firmware_update_mode_activated(Host),
+        defense_disabled(Host, process_monitoring).
+
+% --- T0801_monitor_process_state ---
+    gather_process_state_info(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port).
+
+    compromise(Host, user) :-
+        gather_process_state_info(Host).
+
+% --- T0802_automated_collection ---
+    automated_collection(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        protocol(Host, opc, Port),
+        exposed(Host, Port).
+
+    compromise(Host, user) :-
+        automated_collection(Host).
+
+% --- T0803_block_command_message ---
+    blocked_command_message(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port).
+
+    inhibit_response_function(Host) :-
+        blocked_command_message(Host).
+
+% --- T0804_block_reporting_message ---
+    block_reporting_message(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_endpoint(Host, Port),
+        sensor(Host, telemetry),
+        compromised_device(Host).
+
+compromised_device(Host) :-
+    block_reporting_message(Host).
+
+% --- T0805_block_serial_com ---
+    block_serial_com(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port),
+        protocol(Host, 'telnet', Port),
+        Port >= 20001,
+        Port =< 20003.
+
+% --- T0806_brute_force_i_o ---
+    brute_force_io(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port).
+
+    compromise(Host, user) :-
+        brute_force_io(Host).
+
+% --- T0807_command-line_interface ---
+    exec(Host, User) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        exposed(Host, Port),
+        auth_possible(Host, User, Method),
+        auth_usable_cred(User, Host, Method).
+
+    compromise_from_exec(Host, user) :-
+        exec(Host, User).
+
+% --- T0808_control_device_identification ---
+    control_device_identification(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port),
+        device(Host).
+
+    compromise(Host, user) :-
+        control_device_identification(Host).
+
+% --- T0809_data_destruction ---
+    data_destruction(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        exec(Host, User),
+        has_data(Host, sensitive),
+        compromised_device(Host).
+
+    compromise(Host, user) :-
+        data_destruction(Host).
+
+% --- T0811_data_from_information_repositories ---
+    data_collected_from_repo(Host, DataKind) :-
+        attacker_at(net),
+        connects(net, Host, _Port),
+        has_data(Host, DataKind).
+
+    compromise(Host, user) :-
+        data_collected_from_repo(Host, _DataKind).
+
+% --- T0812_default_credentials ---
+    default_credentials_exploitable(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        auth_usable_cred(User, Host, default),
+        perm(Host, User, admin).
+
+    compromise(Host, admin) :-
+        default_credentials_exploitable(Host).
+
+% --- T0813_denial_of_control ---
+    denial_of_control(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port),
+        role(Host, control_device).
+
+    compromise(Host, user) :-
+        denial_of_control(Host).
+
+% --- T0814_denial_of_service ---
+    denial_of_service(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        exposed(Host, Port),
+        service(Host, Port, Proto, Svc, Version),
+        remote_service_vulnerable(Host, Port, CVE, Svc),
+        exec_possible_remote(Host, User).
+
+    compromise(Host, user) :-
+        denial_of_service(Host).
+
+% --- T0815_denial_of_view ---
+    denial_of_view(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        block_reporting_message(Host).
+
+    compromise(Host, user) :-
+        denial_of_view(Host).
+
+% --- T0816_device_restart_shutdown ---
+    device_restart_shutdown(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port).
+
+    compromise(Host, user) :-
+        device_restart_shutdown(Host).
+
+% --- T0817_drive-by_compromise ---
+    watering_hole_attack(Host) :-
+        attacker_at(net),
+        connects(net, Host, _Port),
+        user_on_host(User, Host),
+        exec_possible_user(Host, User).
+
+    compromise(Host, user) :-
+        watering_hole_attack(Host).
+
+% --- T0818_engineering_workstation_compromise ---
+    compromised_device(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        role(Host, engineering_workstation),
+        (valid_account(User, Host); removable_media_infection(Host)),
+        dual_homed(Host).
+
+    dual_homed(Host) :-
+        connects(Network1, Host, _),
+        connects(Network2, Host, _),
+        Network1 \= Network2.
+
+% --- T0819_exploit_public-facing_application ---
+    exposed(Host, Port) :-
+        attacker_at(net),
+        connects(net, Host, Port).
+
+    remote_service_vulnerable(Host, Port, CVE, Service) :-
+        exposed(Host, Port),
+        service(Host, Port, _Proto, Service, _Version),
+        service_matches(CVE, Service).
+
+    compromise(Host, user) :-
+        remote_service_vulnerable(Host, _Port, _CVE, _Service).
+
+% --- T0820_exploitation_for_evasion ---
+    exploit_for_evasion(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        remote_service_vulnerable(Host, Port, CVE, Service),
+        defense_disabled(Host, SecurityFeature),
+        exec_possible_remote(Host, User).
+
+    compromise(Host, user) :-
+        exploit_for_evasion(Host).
+
+% --- T0821_modify_controller_tasking ---
+    modify_controller_tasking(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_endpoint(Host, Port),
+        exec_possible_remote(Host, User).
+
+    compromise(Host, user) :-
+        modify_controller_tasking(Host).
+
+% --- T0822_external_remote_services ---
+    potential_t0822(Host) :-
+        attacker_at(net),
+        connects(net, Host, Port),
+        exposed(Host, Port),
+        valid_account(User, Host).
+
+    compromise(Host, user) :-
+        potential_t0822(Host).
+
+% --- T0823_graphical_user_interface ---
+    gui_access_possible(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        exposed(Host, Port),
+        service(Host, Port, Protocol, Service, Version),
+        (Protocol = 'VNC'; Protocol = 'RDP').
+
+compromise(Host, user) :-
+    gui_access_possible(Host).
+
+% --- T0824_i_o_module_discovery ---
+    io_module_discovery(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        role(Host, plc),
+        exposed(Host, Port).
+
+    compromise(Host, user) :-
+        io_module_discovery(Host).
+
+% --- T0825_location_identification ---
+    location_identification_possible(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        (has_data(Host, gps_coordinates);
+         has_data(Host, timezone_info);
+         has_data(Host, serial_connection_info)).
+
+    compromise(Host, user) :-
+        location_identification_possible(Host).
+
+% --- T0826_loss_of_availability ---
+    loss_of_availability(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        exposed(Host, Port),
+        has_data(Host, critical),
+        exec_possible_remote(Host, user),
+        compromise(Host, user).
+
+    compromise(Host, user) :-
+        loss_of_availability(Host).
+
+% --- T0827_loss_of_control ---
+    loss_of_control(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port),
+        compromise(Host, control_system).
+
+    compromise(Host, control_system) :-
+        loss_of_control(Host).
+
+% --- T0828_loss_of_productivity_and_revenue ---
+    loss_of_productivity_and_revenue(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port),
+        compromise(Host, user).
+
+    impact_on_operations(Host) :-
+        loss_of_productivity_and_revenue(Host),
+        event(Host, impact, 'T0828', _EvidenceId).
+
+% --- T0829_loss_of_view ---
+    loss_of_view(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port),
+        block_reporting_message(Host).
+
+    compromise(Host, user) :-
+        loss_of_view(Host).
+
+% --- T0830_adversary-in-the-middle ---
+    adversary_in_the_middle(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        privileged_access(Network).
+
+    intercept_traffic(Host) :-
+        adversary_in_the_middle(Host),
+        connects(_, Host, _).
+
+    modify_traffic(Host) :-
+        intercept_traffic(Host).
+
+    block_reporting_message(Host) :-
+        modify_traffic(Host).
+
+    spoof_reporting_message(Host) :-
+        modify_traffic(Host).
+
+    modify_parameter(Host) :-
+        modify_traffic(Host).
+
+    unauthorized_command_message(Host) :-
+        modify_traffic(Host).
+
+% --- T0831_manipulation_of_control ---
+    manipulation_of_control(Host) :-
+        attacker_at(Network),
+        connects(Network, Host, Port),
+        ics_exposed_endpoint(Host, Port),
+        compromised_device(Host).
+
+    compromise(Host, user) :-
+        manipulation_of_control(Host).
+
+% --- T0832_manipulation_of_view ---
