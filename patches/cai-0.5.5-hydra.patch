+"""Native hybrid-reasoning orchestration integrated with CAI."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+from cai.agents.hybrid_reasoner_agent import (
+    attack_paths_context,
+    create_paths_index_message,
+    hybrid_reasoner_agent,
+    load_attack_paths,
+)
+from cai.sdk.agents import Runner
+
+
+@dataclass
+class HybridRunConfig:
+    """Configuration for a native hybrid-reasoning execution."""
+
+    mode: str = "standard"
+    paths_file: str | None = None
+    target: str | None = None
+    query: str | None = None
+    max_turns: int = 50
+
+
+def find_paths_file(mode: str, custom_path: str | None = None) -> Path | None:
+    """Resolve a paths file from explicit input or common MulVAL outputs."""
+    base_dir = Path(__file__).resolve().parents[2]
+
+    if custom_path:
+        candidate = Path(custom_path)
+        if not candidate.is_absolute():
+            candidate = Path.cwd() / candidate
+        if not candidate.exists():
+            candidate = base_dir / custom_path
+        return candidate if candidate.exists() else None
+
+    if mode == "ctf":
+        search_paths = [
+            base_dir / "MulVAL" / "graphs" / "ctf_paths.json",
+            base_dir / "MulVAL" / "graphs" / "paths.json",
+            Path("/tmp/ctf_full_test/paths.json"),
+            base_dir / "ctf_pipeline" / "output" / "paths.json",
+        ]
+    else:
+        search_paths = [
+            base_dir / "MulVAL" / "graphs" / "paths.json",
+            base_dir / "MulVAL" / "AttackAutomatedRuleBase" / "graphs" / "paths.json",
+        ]
+
+    return next((path for path in search_paths if path.exists()), None)
+
+
+def build_default_query(mode: str, target: str | None) -> str:
+    """Build the default user query for the hybrid-reasoning agent."""
+    target_value = target or ("192.168.3.15:3000" if mode == "ctf" else "127.0.0.1")
+
+    if mode == "ctf":
+        return f"""
+Perform a security assessment on the LIVE target system at {target_value}.
+Follow the attack paths provided by the CTF vulnerability analysis.
+Your goal is to achieve system compromise and capture the flag.
+
+CRITICAL: The flag MUST come from the running application at {target_value}.
+Any flags found in source files are placeholders and DO NOT count.
+You must exploit the live web application via HTTP requests or remote code execution.
+""".strip()
+
+    return f"""
+Perform a security assessment on the LIVE target system at {target_value}.
+Follow the attack paths provided by MulVAL analysis.
+Enumerate vulnerabilities and demonstrate exploitation paths.
+
+Ensure all exploitation is performed against the running system, not source code files.
+""".strip()
+
+
+async def run_hybrid_reasoning(config: HybridRunConfig):
+    """Execute hybrid reasoning natively through the CAI runner."""
+    paths_file = find_paths_file(config.mode, config.paths_file)
+    attack_paths = load_attack_paths(str(paths_file)) if paths_file else None
+    paths_message = create_paths_index_message(attack_paths)
+    user_query = config.query or build_default_query(config.mode, config.target)
+    full_message = f"{paths_message}\n\n---\n\n{user_query}"
+
+    with attack_paths_context(attack_paths):
+        return await Runner.run(
+            starting_agent=hybrid_reasoner_agent,
+            input=full_message,
+            max_turns=config.max_turns,
+        )
