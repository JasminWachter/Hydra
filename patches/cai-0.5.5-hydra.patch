+"""
+MulVAL Security Scanner Integration Tool
+
+This tool runs the security scanner pipeline that generates input predicates
+for MulVAL attack graph analysis.
+"""
+
+import os
+import sys
+import subprocess
+from pathlib import Path
+from cai.sdk.agents import function_tool
+
+
+@function_tool
+def run_mulval_scanner(
+    target_dir: str = ".",
+    output_dir: str = "./scan_results",
+    target_host: str = "localhost",
+    docker_image: str = "",
+) -> str:
+    """
+    Run the MulVAL security scanner pipeline to generate input predicates.
+    
+    This tool executes Trivy (filesystem scan), Semgrep (static analysis),
+    and Nmap (network scan) to collect security data that will be used to
+    generate MulVAL predicates for attack graph analysis.
+
+    Args:
+        target_dir: Directory to scan with Trivy filesystem scanner (default: current directory)
+        output_dir: Directory where scan results will be saved (default: ./scan_results)
+        target_host: Target hostname or IP for Nmap network scan (default: localhost)
+        docker_image: Reserved argument for compatibility (currently unused)
+
+    Returns:
+        str: Output from the scanner execution including scan results summary
+        
+    Example:
+        # Scan current directory and localhost
+        result = run_mulval_scanner()
+        
+        # Scan specific directory and network target
+        result = run_mulval_scanner(
+            target_dir="/path/to/project",
+            target_host="192.168.1.100",
+            docker_image="nginx:latest"
+        )
+    """
+    # Locate the scanner script relative to CAI installation
+    script_path = Path(__file__).resolve().parents[4] / "MulVAL" / "generate_predicates.py"
+    
+    if not script_path.exists():
+        return f"Error: Scanner script not found at {script_path}"
+    
+    # Build environment variables
+    env = os.environ.copy()
+    env["TARGET_HOST"] = target_host
+    if docker_image:
+        env["DOCKER_IMAGE"] = docker_image
+    
+    # Execute the scanner script
+    try:
+        result = subprocess.run(
+            [
+                sys.executable,
+                str(script_path),
+                "--target",
+                target_dir,
+                "--output",
+                output_dir,
+                "--host",
+                target_host,
+            ],
+            env=env,
+            capture_output=True,
+            text=True,
+            timeout=300,  # 5 minute timeout
+        )
+        
+        output = result.stdout
+        if result.stderr:
+            output += f"\n\nSTDERR:\n{result.stderr}"
+        
+        if result.returncode != 0:
+            output += f"\n\nWarning: Scanner exited with code {result.returncode}"
+        
+        # Add information about the generated files
+        output += f"\n\nScan results saved to: {output_dir}"
+        output += "\nNext step: Parse these results to generate MulVAL input predicates"
+        
+        return output
+        
+    except subprocess.TimeoutExpired:
+        return "Error: Scanner execution timed out after 5 minutes"
+    except Exception as e:
+        return f"Error executing scanner: {str(e)}"
+
+
+@function_tool
+def run_mulval_attack_graph(
+    input_file: str,
+    rules_file: str = "kb/full_interaction_rules.P",
+) -> str:
+    """
+    Run MulVAL attack graph generation on the provided input predicates.
+    
+    This tool executes the MulVAL reasoning engine to generate attack graphs
+    based on the security predicates generated from scanner results.
+
+    Args:
+        input_file: Path to the input file containing MulVAL predicates (e.g., osint_output/network.P)
+        rules_file: Path to the interaction rules file (default: kb/full_interaction_rules.P)
+
+    Returns:
+        str: Output from MulVAL execution including paths to generated files
+        
+    Example:
+        result = run_mulval_attack_graph(
+            input_file="osint_output/corporate_network.P",
+            rules_file="kb/full_interaction_rules.P"
+        )
+    """
+    # Locate the MulVAL run script
+    mulval_dir = Path(__file__).parent.parent.parent / "MulVAL" / "AttackAutomatedRuleBase"
+    if not mulval_dir.exists():
+        mulval_dir = Path(__file__).parent.parent.parent.parent / "MulVAL" / "AttackAutomatedRuleBase"
+    
+    script_path = mulval_dir / "mulval_execution" / "run.sh"
+    
+    if not script_path.exists():
+        return f"Error: MulVAL run script not found at {script_path}"
+    
+    # Ensure the script is executable
+    try:
+        os.chmod(script_path, 0o755)
+    except Exception as e:
+        return f"Warning: Could not make script executable: {e}"
+    
+    # Execute MulVAL
+    try:
+        # Change to the MulVAL directory for execution
+        original_cwd = os.getcwd()
+        os.chdir(mulval_dir)
+        
+        result = subprocess.run(
+            [str(script_path), input_file, "--rules", rules_file],
+            capture_output=True,
+            text=True,
+            timeout=600,  # 10 minute timeout
+        )
+        
+        os.chdir(original_cwd)
+        
+        output = result.stdout
+        if result.stderr:
+            output += f"\n\nSTDERR:\n{result.stderr}"
+        
+        if result.returncode != 0:
+            output += f"\n\nError: MulVAL exited with code {result.returncode}"
+        
+        return output
+        
+    except subprocess.TimeoutExpired:
+        os.chdir(original_cwd)
+        return "Error: MulVAL execution timed out after 10 minutes"
+    except Exception as e:
+        os.chdir(original_cwd)
+        return f"Error executing MulVAL: {str(e)}"
