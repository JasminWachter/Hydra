+/******************************************************/
+
+% 6.1 Local CVE enables privilege escalation (T1068)
+interaction_rule(
+  (priv_escalated(Host, web_user, root) :-
+    exec_achieved(Host, web_user),
+    vuln(Host, _CVE, _Pkg),
+    exploit_possible(_CVE)),
+  rule_desc('Local CVE exploit escalates web_user to root - T1068', 0.7)).
+
+% 6.2 SUID/misconfiguration based privesc (T1548)
+interaction_rule(
+  (priv_escalated(Host, web_user, root) :-
+    exec_achieved(Host, web_user),
+    os(Host, 'linux')),
+  rule_desc('Linux privesc: check SUID binaries, sudo misconfig, kernel exploits - T1548', 0.5)).
+
+% 6.3 Database to OS escalation  
+interaction_rule(
+  (priv_escalated(Host, web_user, db_admin) :-
+    exec_achieved(Host, web_user),
+    uses_database(Host, _Port, _DbType)),
+  rule_desc('Escalate from web user to database admin via SQL execution - T1068', 0.6)).
+
+
+/******************************************************/
+/****  STAGE 7: CREDENTIAL ACCESS                 *****/
+/****  Execution → credential harvesting          *****/
+/****  Maps to MITRE T1003 OS Credential Dumping  *****/
+/******************************************************/
+
+% 7.1 SQLi → Database credential extraction (T1003)
+interaction_rule(
+  (cred_obtained(Host, db_credentials, Host) :-
+    (initial_access(Host, sqli, _Priv) ; initial_access(Host, sqli_heuristic, _Priv)),
+    uses_database(Host, _Port, _DbType)),
+  rule_desc('SQLi extracts database credentials - T1003 OS Credential Dumping', 0.8)).
+
+% 7.2 NoSQLi → Credential extraction (T1003)
+interaction_rule(
+  (cred_obtained(Host, db_credentials, Host) :-
+    (initial_access(Host, nosqli, _Priv) ; initial_access(Host, nosqli_heuristic, _Priv)),
+    uses_database(Host, _Port, _DbType)),
+  rule_desc('NoSQL injection extracts stored credentials - T1003', 0.75)).
+
+% 7.3 Path traversal → File-based credential access (T1003)
+interaction_rule(
+  (cred_obtained(Host, file_credentials, Host) :-
+    path_traversal_confirmed(Host, Port),
+    connects(_Net, Host, Port)),
+  rule_desc('Path traversal reads credential files (/etc/shadow, .env, config) - T1003', 0.65)).
+
+% 7.3b XSS session hijack → credential material (T1185/T1550)
+interaction_rule(
+  (cred_obtained(Host, session_token, Host) :-
+    initial_access(Host, xss_session, _Priv),
+    has_cookie_auth(Host, _Port)),
+  rule_desc('XSS steals session cookies/tokens that grant authenticated access - T1185/T1550', 0.74)).
+
+% 7.4 DEMOTED: generic credential dump fired from any exec_achieved on every challenge.
+% Credential access now follows from a class-specific confirmed exploit (7.1–7.3).
+
+% 7.5 SSRF → Internal credential access (T1552)
+interaction_rule(
+  (cred_obtained(Host, cloud_metadata, Host) :-
+    ssrf_confirmed(Host, _Port)),
+  rule_desc('SSRF accesses cloud metadata endpoint for credentials - T1552', 0.6)).
+
+
+/******************************************************/
+/****  STAGE 8: DATA ACCESS & EXFILTRATION        *****/
+/****  Credential/exec → data theft               *****/
+/****  Maps to MITRE T1005 Data from Local System *****/
+/******************************************************/
+
+% 8.1 SQLi → Data exfiltration (T1005/T1530)
+interaction_rule(
+  (data_exfiltrated(Host, database_dump, sqli) :-
+    sqli_confirmed(Host, _Port),
+    uses_database(Host, _DbPort, _DbType),
+    has_data(Host, _DataType)),
+  rule_desc('SQLi dumps database contents - T1005 Data from Local System', 0.8)).
+
+% 8.2 NoSQLi → Data exfiltration
+interaction_rule(
+  (data_exfiltrated(Host, database_dump, nosqli) :-
+    nosql_injection_confirmed(Host, _Port),
+    has_data(Host, _DataType)),
+  rule_desc('NoSQL injection dumps database contents - T1005', 0.75)).
+
+% 8.3 Path traversal → File exfiltration (T1005)
+interaction_rule(
+  (data_exfiltrated(Host, sensitive_files, path_traversal) :-
+    path_traversal_confirmed(Host, _Port),
+    has_data(Host, _DataType)),
+  rule_desc('Path traversal reads sensitive files - T1005', 0.7)).
+
+% 8.4 Execution → Data collection (T1005)
+interaction_rule(
+  (data_exfiltrated(Host, system_data, exec) :-
+    exec_achieved(Host, _Priv),
+    has_data(Host, _DataType)),
+  rule_desc('Command execution collects and exfiltrates data - T1005', 0.75)).
+
+
+/******************************************************/
+/****  STAGE 9: LATERAL MOVEMENT                  *****/
+/****  Creds on Host A → access Host B            *****/
+/****  Maps to MITRE T1021 Remote Services        *****/
+/******************************************************/
+
+% 9.1 Credentials enable lateral movement (T1021)
+interaction_rule(
+  (lateral_access(TargetHost, user) :-
+    cred_obtained(_SourceHost, _CredType, TargetHost),
+    service(TargetHost, _Port, _Proto, _Svc, _Ver),
+    connects(_Net, TargetHost, _Port)),
+  rule_desc('Harvested credentials enable lateral movement - T1021 Remote Services', 0.7)).
+
+% 9.2 Same-host credential reuse (T1078)
+interaction_rule(
+  (lateral_access(Host, admin) :-
+    cred_obtained(Host, _CredType, Host),
+    auth_service(Host, _Port, _Svc)),
+  rule_desc('Credential reuse on same host escalates access - T1078 Valid Accounts', 0.7)).
+
+
+/******************************************************/
+/****  STAGE 10: COMPROMISE (FINAL)               *****/
+/****  All paths converge to compromise           *****/
+/******************************************************/
+
+% 10.1 Privilege escalation → full compromise
+interaction_rule(
+  (compromise(Host, root) :-
+    priv_escalated(Host, _FromPriv, root)),
+  rule_desc('Privilege escalation achieves full system compromise', 0.95)).
+
+% 10.2 Execution as web_user → partial compromise
+interaction_rule(
+  (compromise(Host, web_user) :-
+    exec_achieved(Host, web_user)),
+  rule_desc('Web-level code execution achieves partial compromise', 0.8)).
+
+% 10.3 Lateral access → compromise on target
+interaction_rule(
+  (compromise(Host, user) :-
+    lateral_access(Host, _Priv)),
+  rule_desc('Lateral movement achieves compromise on target host', 0.85)).
+
+% 10.4 Data exfiltration → compromise (impact achieved)
+interaction_rule(
+  (compromise(Host, data_breach) :-
+    data_exfiltrated(Host, _DataType, _Method)),
+  rule_desc('Data exfiltration constitutes compromise (impact) - T1567', 0.9)).
+
+% 10.5 Credential obtained → partial compromise
+interaction_rule(
+  (compromise(Host, user) :-
+    cred_obtained(Host, _CredType, _Target)),
+  rule_desc('Credential access constitutes partial compromise - T1003', 0.7)).
+
+
+/******************************************************/
+/****  STAGE 11: MITRE BRIDGE                     *****/
+/****  Connect web stages to full_interaction_    *****/
+/****  rules post-exploitation chains             *****/
+/****  Prevents MITRE rules creating standalone   *****/
+/****  noise paths that bypass web stages         *****/
+/******************************************************/
+
+% Bridge: web exec_achieved → MulVAL execCode (required by MITRE PE/LM rules)
+% This forces full_interaction_rules post-exploitation to extend web paths
+% rather than fire independently from raw scanner facts.
+interaction_rule(
+  (execCode(Host, web_user) :-
+    exec_achieved(Host, web_user),
+    web_service(Host, _Port, _Tech)),
+  rule_desc('Web execution bridges to MITRE post-exploitation chain - exec_achieved', 0.9)).
+
+interaction_rule(
+  (execCode(Host, root) :-
+    priv_escalated(Host, web_user, root)),
+  rule_desc('Privilege escalation bridges to MITRE root-level post-exploitation', 0.9)).
+
+% Bridge: any compromise → execCode
+% MulVAL attack_graph binary only recognises execCode as a terminal goal predicate.
+% This rule maps every compromise fact to the standard execCode form so
+% attack_graph can render the visual graph and render.sh can produce the PDF.
+interaction_rule(
+  (execCode(Host, user) :-
+    compromise(Host, _)),
+  rule_desc('Web compromise achieves standard execCode - T1059 command and scripting interpreter', 0.9)).
+
+% Bridge: feed web execution / privesc into the MITRE predicate names so the curated
+% full_post_exploit_rules.P post-exploitation techniques (persistence, privesc, impact)
+% extend the web path instead of needing facts the scanners never produce.
+interaction_rule(
+  (exec(Host, web_user) :-
+    exec_achieved(Host, web_user)),
+  rule_desc('Web code execution feeds MITRE post-exploitation (exec) - T1059', 0.85)).
+
+interaction_rule(
+  (priv_escalation(Host, From, To) :-
+    priv_escalated(Host, From, To)),
+  rule_desc('Web privilege escalation feeds MITRE post-exploitation (priv_escalation) - T1068', 0.8)).
+
+/******************************************************/
+/****  STAGE 12: FLAG LOCALIZATION (CTF terminal)  ****/
+/****  Attach the concrete flag location to the    ****/
+/****  terminal so paths point at file:line / sink ****/
+/******************************************************/
+
+% Code/command execution can read the runtime flag stored in a file or database.
+interaction_rule(
+  (compromise(Host, flag_read) :-
+    exec_achieved(Host, _Priv),
+    flag_location(Host, Where, _Ref, _File, _Line),
+    (Where = file ; Where = db)),
+  rule_desc('Execution retrieves the flag at this location', 0.85)).
+
+% SSRF/bot fetch that satisfies a localhost-only gate leaks a cookie-borne flag.
+interaction_rule(
+  (compromise(Host, flag_cookie) :-
+    ssrf_confirmed(Host, _Port),
+    access_gate(Host, _GFile, _GLine, localhost_only),
+    flag_location(Host, cookie, _Ref, _File, _Line)),
+  rule_desc('SSRF/bot fetch satisfies localhost-only gate to leak the flag cookie', 0.8)).
